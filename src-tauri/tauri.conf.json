{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "ResearchFlow",
  "version": "1.7.2",
  "identifier": "com.researchflow.desktop",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://127.0.0.1:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "widget",
        "title": "ResearchFlow · 科研续航",
        "url": "index.html?view=widget",
        "width": 320,
        "height": 400,
        "resizable": false,
        "decorations": false,
        "transparent": true,
        "shadow": true,
        "visible": false,
        "skipTaskbar": true,
        "create": false
      },
      {
        "label": "manager",
        "dragDropEnabled": false,
        "backgroundColor": "#faf9f6",
        "title": "ResearchFlow · 科研工作台",
        "url": "index.html",
        "width": 900,
        "height": 650,
        "minWidth": 720,
        "minHeight": 560,
        "decorations": false,
        "visible": false,
        "center": true,
        "create": false
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; connect-src ipc: http://ipc.localhost; object-src 'none'; base-uri 'self'; form-action 'self'"
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "nsis"
    ],
    "icon": [
      "icons/icon.ico",
      "icons/icon.png"
    ],
    "shortDescription": "科研续航桌面组件",
    "longDescription": "让好奇心负责探索，让工作系统负责持续推进。所有数据离线保存在本机。",
    "windows": {
      "webviewInstallMode": {
        "type": "downloadBootstrapper",
        "silent": true
      },
      "nsis": {
        "installMode": "currentUser",
        "languages": [
          "SimpChinese",
          "English"
        ],
        "displayLanguageSelector": false
      }
    },
    "resources": {
      "../THIRD_PARTY_NOTICES.txt": "THIRD_PARTY_NOTICES.txt"
    }
  }
}
